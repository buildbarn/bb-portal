load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:layer.bzl", "layer_from_binary", "layer_from_tar")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

go_library(
    name = "postgres_lib",
    srcs = ["main.go"],
    importpath = "github.com/buildbarn/bb-portal/test/itest/postgres",
    visibility = ["//visibility:private"],
    deps = [
        "@com_github_fergusstrange_embedded_postgres//:embedded-postgres",
        "@rules_go//go/runfiles",
    ],
)

go_binary(
    name = "postgres",
    data = ["//internal/database/embedded:extraced_embedded_postgres"],
    embed = [":postgres_lib"],
)

go_test(
    name = "postgres_test",
    srcs = ["main_test.go"],
    embed = [":postgres_lib"],
    deps = ["@com_github_stretchr_testify//require"],
)

layer_from_binary(
    name = "postgres_image_layer",
    binary = ":postgres",
    include_runfiles = False,
    path = "app/postgres",
    tags = ["manual"],
)

layer_from_tar(
    name = "postgres_files_layer",
    src = "//internal/database/embedded:embedded_postgres_image_tar",
    tags = ["manual"],
)

pkg_tar(
    name = "postgres_shell_tar",
    symlinks = {"bin/sh": "/busybox/sh"},
    tags = ["manual"],
)

layer_from_tar(
    name = "postgres_shell_layer",
    src = ":postgres_shell_tar",
    tags = ["manual"],
)

image_manifest(
    name = "postgres_image",
    base = "@distroless_cc_debian12_debug",
    env = {"POSTGRES_BINARIES": "/"},
    layers = [
        ":postgres_files_layer",
        ":postgres_shell_layer",
        ":postgres_image_layer",
    ],
    platform = select({
        "@platforms//cpu:aarch64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_arm64",
        "@platforms//cpu:x86_64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_amd64",
    }),
    stop_signal = "SIGTERM",
    tags = ["manual"],
    user = "65532:65532",
)

image_load(
    name = "postgres_image.load",
    image = ":postgres_image",
    tag = "bb-portal/postgres:itest",
    visibility = ["//test/itest:__pkg__"],
)
