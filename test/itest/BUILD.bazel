load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_docker_compose//docker_compose:defs.bzl", "docker_compose_binary", "docker_compose_yaml")
load("@rules_img//img:image.bzl", "image_manifest")
load("@rules_img//img:load.bzl", "image_load")
load("@rules_itest//:itest.bzl", "itest_service", "itest_service_group", "service_test")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

copy_to_bin(
    name = "buildbarn_compose_file",
    srcs = ["buildbarn/docker-compose.yml"],
)

copy_to_bin(
    name = "buildbarn_config_files",
    srcs = glob(["buildbarn/config/**"]),
)

copy_to_directory(
    name = "buildbarn_fuse_volume",
    srcs = ["buildbarn/volumes/worker-fuse/.gitkeep"],
    out = "buildbarn/volumes/worker-fuse",
    root_paths = ["test/itest/buildbarn/volumes/worker-fuse"],
)

image_manifest(
    name = "buildbarn_bb_storage_image",
    base = "@buildbarn_bb_storage_image",
    platform = select({
        "@platforms//cpu:aarch64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_arm64",
        "@platforms//cpu:x86_64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_amd64",
    }),
    tags = ["manual"],
)

image_load(
    name = "buildbarn_bb_storage_image.load",
    image = ":buildbarn_bb_storage_image",
    tag = "ghcr.io/buildbarn/bb-storage:20260609T094425Z-10acc76",
)

image_manifest(
    name = "buildbarn_bb_scheduler_image",
    base = "@buildbarn_bb_scheduler_image",
    platform = select({
        "@platforms//cpu:aarch64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_arm64",
        "@platforms//cpu:x86_64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_amd64",
    }),
    tags = ["manual"],
)

image_load(
    name = "buildbarn_bb_scheduler_image.load",
    image = ":buildbarn_bb_scheduler_image",
    tag = "ghcr.io/buildbarn/bb-scheduler:20260527T162223Z-c48dcda",
)

image_manifest(
    name = "buildbarn_bb_worker_image",
    base = "@buildbarn_bb_worker_image",
    platform = select({
        "@platforms//cpu:aarch64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_arm64",
        "@platforms//cpu:x86_64": "@com_github_buildbarn_bb_storage//tools/platforms:linux_amd64",
    }),
    tags = ["manual"],
)

image_load(
    name = "buildbarn_bb_worker_image.load",
    image = ":buildbarn_bb_worker_image",
    tag = "ghcr.io/buildbarn/bb-worker:20260527T162223Z-c48dcda",
)

image_manifest(
    name = "buildbarn_bb_runner_installer_image",
    base = "@buildbarn_bb_runner_installer_image",
    platform = "@com_github_buildbarn_bb_storage//tools/platforms:linux_amd64",
    tags = ["manual"],
)

image_load(
    name = "buildbarn_bb_runner_installer_image.load",
    image = ":buildbarn_bb_runner_installer_image",
    tag = "ghcr.io/buildbarn/bb-runner-installer:20260527T162223Z-c48dcda",
)

docker_compose_yaml(
    name = "buildbarn_compose_yaml",
    data = [
        ":buildbarn_config_files",
        ":buildbarn_fuse_volume",
    ],
    images = [
        ":buildbarn_bb_runner_installer_image.load",
        ":buildbarn_bb_scheduler_image.load",
        ":buildbarn_bb_storage_image.load",
        ":buildbarn_bb_worker_image.load",
        "//test/itest/postgres:postgres_image.load",
        "//test/itest/volume_initializer:volume_initializer_image.load",
    ],
    yamls = [":buildbarn_compose_file"],
)

docker_compose_binary(
    name = "buildbarn_compose",
    visibility = ["//visibility:public"],
    yaml = ":buildbarn_compose_yaml",
)

platform(
    name = "local_rbe_linux_amd64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    exec_properties = {
        "OSFamily": "linux",
        "container-image": "docker://ghcr.io/catthehacker/ubuntu:act-22.04@sha256:dd7654ffb01d5b7b54b23b9ce928a1f7f2d08c7b3d7e320b6574b55d7ccde78b",
    },
    visibility = ["//visibility:public"],
)

# These services use fixed ports so a separate Bazel invocation can publish
# its BEP. Disable generated hygiene tests, which may run concurrently and
# contend for those ports.
itest_service(
    name = "buildbarn_service",
    args = [
        "--ansi=never",
    ] + select({
        "@platforms//os:linux": [
            "--profile",
            "fuse",
        ],
        "//conditions:default": [],
    }) + [
        "up",
        "--force-recreate",
        "--remove-orphans",
    ],
    exe = ":buildbarn_compose",
    expected_start_duration = "20s",
    health_check = "//test/itest/stack_healthcheck",
    health_check_args = [
        "postgresql://app:password@127.0.0.1:15432/postgres?sslmode=disable",
        "127.0.0.1:18980",
        "127.0.0.1:18984",
        "http://127.0.0.1:26686/api/services",
        "hardlinking",
    ] + select({
        "@platforms//os:linux": ["fuse"],
        "//conditions:default": [],
    }),
    health_check_timeout = "10m",
    hygienic = False,
    shutdown_timeout = "45s",
)

itest_service(
    name = "bb_portal_frontend",
    exe = "//frontend:vite_dev_server",
    # The first Vite dependency optimization pass takes longer than restarts.
    expected_start_duration = "15s",
    http_health_check_address = "http://127.0.0.1:5173/",
    hygienic = False,
    shutdown_timeout = "15s",
)

itest_service(
    name = "bb_portal_backend",
    args = ["$(location :portal.jsonnet)"],
    data = [":portal.jsonnet"],
    exe = "//cmd/bb_portal",
    expected_start_duration = "5s",
    http_health_check_address = "http://127.0.0.1:18081/",
    hygienic = False,
    shutdown_timeout = "15s",
    deps = [
        ":bb_portal_frontend",
        ":buildbarn_service",
    ],
)

itest_service_group(
    name = "bb_portal",
    hygienic = False,
    services = [":bb_portal_backend"],
    visibility = ["//visibility:public"],
)

service_test(
    name = "bb_portal_test",
    services = [":bb_portal"],
    tags = ["requires-network"],
    test = ":exit0",
    visibility = ["//visibility:public"],
)

# The rules_itest sample exit0 is a cc_binary, which makes //... require a C++
# toolchain for every requested cross-compilation platform.
sh_binary(
    name = "exit0",
    srcs = ["exit0.sh"],
)

# A tool-free action that can be executed on the Linux runner even when the
# repository has no remote C/C++ or Go toolchains configured.
genrule(
    name = "rbe_smoke",
    outs = ["rbe-smoke.txt"],
    cmd = "printf 'Executed by the local Buildbarn worker.\\n' > $@",
    exec_properties = {
        "OSFamily": "linux",
        "container-image": "docker://ghcr.io/catthehacker/ubuntu:act-22.04@sha256:dd7654ffb01d5b7b54b23b9ce928a1f7f2d08c7b3d7e320b6574b55d7ccde78b",
    },
    visibility = ["//visibility:public"],
)
