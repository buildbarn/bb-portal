load("@com_github_buildbarn_bb_storage//tools:container.bzl", "container_push_official", "multiarch_go_image")
load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "bb_portal_lib",
    srcs = ["main.go"],
    importpath = "github.com/buildbarn/bb-portal/cmd/bb_portal",
    visibility = ["//visibility:private"],
    deps = [
        "//ent/gen/ent/migrate",
        "//ent/gen/ent/runtime",
        "//internal/api/common",
        "//internal/api/http/graphql_api_service",
        "//internal/api/http/zstdmiddleware",
        "//internal/bep",
        "//internal/database",
        "//internal/database/common",
        "//internal/database/dbcleanupservice",
        "//pkg/frontend",
        "//pkg/grpcweb/blobstoreservice",
        "//pkg/grpcweb/schedulerservice",
        "//pkg/prometheus_metrics",
        "//pkg/proto/configuration/bb_portal",
        "@com_github_buildbarn_bb_storage//pkg/auth",
        "@com_github_buildbarn_bb_storage//pkg/auth/configuration",
        "@com_github_buildbarn_bb_storage//pkg/blobstore",
        "@com_github_buildbarn_bb_storage//pkg/blobstore/configuration",
        "@com_github_buildbarn_bb_storage//pkg/clock",
        "@com_github_buildbarn_bb_storage//pkg/digest",
        "@com_github_buildbarn_bb_storage//pkg/global",
        "@com_github_buildbarn_bb_storage//pkg/grpc",
        "@com_github_buildbarn_bb_storage//pkg/http/server",
        "@com_github_buildbarn_bb_storage//pkg/program",
        "@com_github_buildbarn_bb_storage//pkg/util",
        "@com_github_buildbarn_bb_storage//pkg/zstd",
        "@io_opentelemetry_go_contrib_instrumentation_net_http_otelhttp//:otelhttp",
        "@io_opentelemetry_go_otel//:otel",
        "@io_opentelemetry_go_otel_trace//:trace",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

multiarch_go_image(
    name = "bb_portal_container",
    binary = ":bb_portal",
)

container_push_official(
    name = "bb_portal_container_push",
    component = "bb-portal",
    image = ":bb_portal_container",
)

go_binary(
    name = "bb_portal",
    embed = [":bb_portal_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bb_portal_test",
    srcs = [
        "main_process_test.go",
        "main_test.go",
    ],
    # main_process_test.go runs the binary.
    data = [":bb_portal"],
    embed = [":bb_portal_lib"],
    env = {"BB_PORTAL_BINARY": "$(rlocationpath :bb_portal)"},
    deps = [
        "//ent/gen/ent/migrate",
        "//internal/database",
        "//internal/database/dbauthservice",
        "//internal/database/embedded",
        "//pkg/prometheus_metrics",
        "//pkg/proto/configuration/bb_portal",
        "@com_github_buildbarn_bb_storage//pkg/zstd",
        "@com_github_google_uuid//:uuid",
        "@com_github_prometheus_client_golang//prometheus/testutil",
        "@com_github_stretchr_testify//require",
        "@io_opentelemetry_go_otel_trace//noop",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_google_protobuf//encoding/protojson",
        "@rules_go//go/runfiles",
    ],
)
